# Everything the image does not need. Without this the build context is 40MB+,
# almost all of it the ProPublica response cache.

.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache

# Secrets never belong in an image. They arrive as environment variables.
.env
**/.env
*.env

# Measurement output and caches. `docs/` is deliberately not here: the filed
# returns are the benchmark's reference documents and are read at runtime.
data/propublica_cache
data/propublica_harness
data/classification_runs
data/classification_harness
data/.qb_cache
data/quickbooks_crn

tests
scripts
notebooks
*.md
!README.md
