# -----------------------------------------------------------------------------
# AI-Powered Intelligent Document Extractor - Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.
# For production, use AWS Secrets Manager or SSM for API keys and JWT secret.
# -----------------------------------------------------------------------------

# --- Environment ---
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FORMAT=json for production log aggregators

# --- AWS (required for AWS_textract extractor and LLM) ---
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# (Or use IAM role / instance profile in production)

#for textract
AWS_REGION=us-east-1
BUCKET_NAME=your-s3-bucket-name
# AWS_SSL_VERIFY=false

#LLM
LLM_PROVIDER=bedrock # or openai, azure
LLM_TIMEOUT=60
REPORTS_LLM_TIMEOUT=86400
REPORTS_MAX_TOKENS=32768
REPORTS_TAX_RETURN_SECTION_MAX_TOKENS=12288
REPORTS_TAX_RETURN_RECONCILIATION_MAX_TOKENS=8192
REPORTS_WA_MAX_RECORDS_PER_ENTITY=50
REPORTS_WA_FINANCIAL_RECORDS_PER_ENTITY=200

# Unified model key (reports + LLM). MODEL_ID is accepted as a legacy alias.
LLM_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0 # or gpt-4o
# MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# OpenAI specific
# OPENAI_API_KEY="your openai api key"

# --- Extractor (choose one) ---
# AWS_textract = AWS Textract + S3 (best accuracy; requires AWS)
# goml_custom_extractor = Local libraries (offline; no AWS for extraction)
EXTRACTOR_TYPE=AWS_textract

# --- File limits ---
MAX_FILE_SIZE_MB=100
MAX_PAGES_PER_REQUEST=50
CHUNK_SIZE_MB=10
MAX_BATCH_FILES=10

# --- Timeouts (seconds) ---
TEXTRACT_TIMEOUT=300
LLM_TIMEOUT=60
FILE_UPLOAD_TIMEOUT=120
SHUTDOWN_DRAIN_SECONDS=30

# --- Concurrency ---
MAX_WORKERS=4
MAX_CONCURRENT_PAGES=5

# --- S3 ---
S3_PREFIX=document-uploads
S3_TEMP_EXPIRY_DAYS=1

# --- Retries ---
MAX_RETRIES=3
RETRY_DELAY=1.0

# --- Health (optional dependency checks in readiness) ---
# HEALTH_CHECK_S3=false
# HEALTH_CHECK_BEDROCK=false

# --- Auth: none | api_key | bearer | jwt ---
# Set AUTH_METHOD=bearer and BEARER_TOKEN to enable Swagger "Authorize" button
AUTH_METHOD=bearer
# API_KEY=single-key
# API_KEYS=key1,key2,key3
BEARER_TOKEN=change-me-to-a-secure-random-token
# JWT_SECRET=your-jwt-secret
# JWT_ALGORITHM=HS256

# --- Rate limiting ---
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_PER_MINUTE=60

# --- Input hardening: comma-separated MIME types; empty = no check ---
# ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,image/png,image/jpeg

# --- Benchmark reference documents ---
# BENCHMARK_DOCS_LOCAL_PATH=docs
# BENCHMARK_DOCS_S3_BUCKET=goml-accountbridge-benchmarking-docs
# BENCHMARK_DOCS_S3_PREFIX=manual_reports/
# BENCHMARK_DOCS_SOURCE=s3
# BENCHMARK_LLM_MAX_TOKENS=16384

# --- WildApricot (membership / donor / event data for Form 990) ---
# WILDAPRICOT_OAUTH_URL=https://oauth.wildapricot.org/auth/token
# WILDAPRICOT_API_BASE_URL=https://api.wildapricot.org
# WILDAPRICOT_API_KEY=your-admin-api-key
# WILDAPRICOT_ACCOUNT_ID=
# WILDAPRICOT_TOKEN_REFRESH_BUFFER_SECONDS=300
# WILDAPRICOT_HTTP_TIMEOUT_SECONDS=60
# WILDAPRICOT_EXPORT_DIR=exports/wildapricot
# WILDAPRICOT_EXPORT_JSON=
# WILDAPRICOT_EXPORT_CSV=true
# WILDAPRICOT_MAX_REQUESTS_PER_MINUTE=28
# WILDAPRICOT_RETRY_MAX_ATTEMPTS=8
# WILDAPRICOT_RETRY_429_DELAY_SECONDS=62
# WILDAPRICOT_RETRY_429_MAX_DELAY_SECONDS=120

# --- QuickBooks (financial reports) ---
# Step 1: developer.intuit.com → app → Keys & OAuth
#         Add redirect URI: https://developer.intuit.com/v2/OAuth2Playground/RedirectUrl
# Step 2: OAuth playground → Get Tokens → copy refresh_token into .env
#         Or submit credentials via Streamlit UI or POST /api/quickbooks/credentials
# Step 3: App auto-refreshes access tokens every ~50 min (no manual OAuth after setup)
# QUICKBOOKS_CLIENT_ID=your-client-id
# QUICKBOOKS_CLIENT_SECRET=your-client-secret
# QUICKBOOKS_REFRESH_TOKEN=your-refresh-token-from-playground
# QUICKBOOKS_REALM_ID=9341457191103538
# QUICKBOOKS_ACCESS_TOKEN=optional-seed-auto-updated-by-app
# QUICKBOOKS_REDIRECT_URI=https://developer.intuit.com/v2/OAuth2Playground/RedirectUrl
# QUICKBOOKS_SANDBOX_BASE_URL=https://sandbox-quickbooks.api.intuit.com
# QUICKBOOKS_OUTPUT_DIR=data/quickbooks
# QUICKBOOKS_AUTO_REFRESH_ENABLED=true
# QUICKBOOKS_AUTO_REFRESH_INTERVAL_MINUTES=50
